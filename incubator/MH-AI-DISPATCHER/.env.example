# Server
MH_BIND_HOST=127.0.0.1
MH_PORT=8787
MH_CONTROL_TOKEN=replace-with-a-long-random-token
MH_DATA_DIR=.mh-dispatcher
MH_MAX_PARALLEL=2
MH_TASK_TIMEOUT_MS=2700000
MH_REVIEW_TIMEOUT_MS=900000
MH_GIT_PUSH=false

# Claude Code executor. Leave MH_CLAUDE_MODEL empty to use ~/.claude/settings.json
# (this preserves custom gateway/model routing such as cx/gpt-5.6-sol).
MH_CLAUDE_COMMAND=claude
MH_CLAUDE_MODEL=
MH_CLAUDE_PERMISSION_MODE=acceptEdits
MH_CLAUDE_MAX_TURNS=40
MH_CLAUDE_MAX_BUDGET_USD=
MH_CLAUDE_ALLOWED_TOOLS=Read,Edit,Write,Glob,Grep,Bash(git status *),Bash(git diff *),Bash(git log *),Bash(git add *),Bash(git commit *),Bash(npm test *),Bash(npm run *),Bash(npx *)

# Antigravity executor
MH_AGY_COMMAND=agy
MH_AGY_MODEL=
# false by default. Turn on only after testing on isolated worktrees.
MH_AGY_SKIP_PERMISSIONS=false

# Reviewer. Leave model blank to use the existing Claude Code configuration.
MH_REVIEWER_COMMAND=claude
MH_REVIEWER_MODEL=
MH_REVIEWER_MAX_TURNS=15

# Notion reporting. If token is absent, Notion reporting is disabled.
NOTION_TOKEN=
NOTION_VERSION=2026-03-11
NOTION_WORK_ORDERS_SOURCE_ID=baf3e579-4081-4aeb-b4b0-8b633febf00e
NOTION_REVIEWS_SOURCE_ID=cafc77b3-78a3-46e9-810f-fd93a734d100
NOTION_EVIDENCE_SOURCE_ID=37910ddc-c20b-4025-9ff3-66293383739a
