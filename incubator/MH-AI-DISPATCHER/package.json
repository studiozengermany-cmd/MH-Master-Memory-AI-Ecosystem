{
  "name": "mh-ai-dispatcher",
  "version": "0.1.0",
  "private": true,
  "description": "MINH HIEU STUDIO AI dispatcher: locked plan -> specialist execution -> review -> Notion evidence.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "mcp:stdio": "tsx src/mcp/stdio.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.15.30",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
